{
  "name": "drive-fm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:road": "tsx tools/road-check.ts",
    "test:drive": "node tools/long-drive.mjs",
    "test:handling": "tsx tools/handling.ts",
    "test:people": "node --expose-gc --import tsx tools/people-check.ts",
    "test:perf": "node tools/perf-check.mjs",
    "test:load": "node tools/load-check.mjs",
    "test:frontend": "node tools/check-frontend.mjs",
    "bench:world": "tsx tools/world-bench.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "1.56",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
